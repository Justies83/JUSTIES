---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';
import { CATEGORIES } from '../data/taxonomy';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();

// The home page is the newest writing and little else. `featured` only pulls a
// post forward in the queue — it never holds a slot on its own, so an old
// pinned post cannot keep sitting on the front page as newer ones arrive.
const ordered = [...posts].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

// Four, same size, and spread across sections where possible: one per
// category first (newest of each), then the newest leftovers fill any
// empty slots. Everything older lives in /archive, one click away.
const featured: typeof ordered = [];
const usedCategoryIds = new Set<string>();
for (const post of ordered) {
  if (featured.length >= 4) break;
  if (usedCategoryIds.has(post.data.category)) continue;
  usedCategoryIds.add(post.data.category);
  featured.push(post);
}
for (const post of ordered) {
  if (featured.length >= 4) break;
  if (!featured.includes(post)) featured.push(post);
}
featured.sort((a, b) => ordered.indexOf(a) - ordered.indexOf(b));

const countByCategory = (id: string) => posts.filter((p) => p.data.category === id).length;
// A section with nothing in it is a dead link, so it is left out.
const usedCategories = CATEGORIES.filter((c) => countByCategory(c.id) > 0);

// Everything the hover panel needs, grouped by category and already in
// newest-first order. Sorting by views happens in the browser once the counts
// arrive, so the default order works even if that request never lands.
const topicPosts = Object.fromEntries(
  usedCategories.map((category) => [
    category.id,
    {
      label: category.label,
      href: `/topics/${category.id}`,
      posts: posts
        .filter((p) => p.data.category === category.id)
        .map((p) => ({
          id: p.id,
          title: p.data.title,
          date: p.data.date.toISOString().slice(0, 10).replace(/-/g, '.'),
        })),
    },
  ])
);

const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${origin}#site`,
      url: origin,
      name: site.title,
      description: site.description,
      inLanguage: 'ko-KR',
      publisher: { '@type': 'Person', name: site.author, url: `${origin}/about` },
    },
    {
      '@type': 'Blog',
      '@id': `${origin}#blog`,
      url: origin,
      name: site.title,
      description: site.description,
      inLanguage: 'ko-KR',
      blogPost: posts.slice(0, 10).map((p) => ({
        '@type': 'BlogPosting',
        headline: p.data.title,
        url: `${origin}/posts/${p.id}`,
        datePublished: p.data.date.toISOString(),
      })),
    },
  ],
};
---

<Base schema={schema}>
  <section class="shell masthead">
    <h1>{site.title}</h1>
    <p>{site.description}</p>
  </section>

  <div class="shell">
    <section class="section" id="latest">
      <SectionHead
        eyebrow="LATEST"
        title="최근 글"
        linkHref="/archive"
        linkLabel="전체 보기"
      />

      {featured.length > 0 ? (
        <div class="bento bento-even">
          {featured.map((post) => <PostCard post={post} />)}
        </div>
      ) : (
        <div class="empty">
          <strong>첫 기록을 기다리고 있습니다.</strong>
          <p style="margin:0">
            <code>src/content/posts/</code> 에 마크다운 파일을 추가하면 이 자리에 바로 나타납니다.
          </p>
        </div>
      )}
    </section>

    <section class="section section-quiet" id="topics">
      <SectionHead eyebrow="TOPICS" linkHref="/topics" linkLabel="전체 주제" />

      <div class="topic-peek" data-topic-peek>
        <nav class="filters" aria-label="주제 이동">
          {usedCategories.map((category) => (
            <a class="chip" href={`/topics/${category.id}`} data-topic={category.id}>
              {category.label} {countByCategory(category.id)}
            </a>
          ))}
        </nav>

        {/* Hidden until a chip is pointed at or focused. Populated from the
            JSON below, so no request is needed to open it. */}
        <div class="peek-panel" data-peek-panel hidden>
          <div class="peek-head">
            <strong data-peek-title></strong>
            <div class="peek-sorts" role="group" aria-label="정렬 기준">
              <button type="button" class="peek-sort" data-sort="date" aria-pressed="true">최신순</button>
              <button type="button" class="peek-sort" data-sort="views" aria-pressed="false">조회순</button>
            </div>
          </div>
          <ol class="peek-list" data-peek-list></ol>
        </div>
      </div>

      <script
        type="application/json"
        data-topic-posts
        is:inline
        set:html={JSON.stringify(topicPosts)}
      />
    </section>
  </div>

  {/* Follows the pointer over a card or row. Cover, title, one-line summary
      and a prompt — never the body, so it invites the click instead of
      answering it. */}
  <div class="hover-peek" id="hover-peek" hidden aria-hidden="true">
    <div class="hover-peek-cover"><img alt="" /></div>
    <div class="hover-peek-body">
      <p class="mono"><span data-hp-cat></span> · <span data-hp-date></span></p>
      <strong data-hp-title></strong>
      <p data-hp-takeaway></p>
      <span class="hover-peek-cta">눌러서 읽기 →</span>
    </div>
  </div>
</Base>

<script>
  // Topic previews: point at (or focus, or tap) a chip and the panel lists
  // that topic's posts. Newest-first by default; the 조회순 toggle re-sorts
  // once /api/views has answered, and is remembered per browser.
  type Entry = { id: string; title: string; date: string };
  type Topic = { label: string; href: string; posts: Entry[] };

  const root = document.querySelector('[data-topic-peek]');
  const dataEl = document.querySelector('[data-topic-posts]');
  const panel = document.querySelector('[data-peek-panel]') as HTMLElement | null;
  const titleEl = document.querySelector('[data-peek-title]');
  const listEl = document.querySelector('[data-peek-list]');

  if (root && dataEl && panel && titleEl && listEl) {
    const topics: Record<string, Topic> = JSON.parse(dataEl.textContent || '{}');
    let views: Record<string, number> | null = null;
    let current: string | null = null;
    let sort: 'date' | 'views' = 'date';
    try {
      const saved = localStorage.getItem('justies-topic-sort');
      if (saved === 'views' || saved === 'date') sort = saved;
    } catch {}

    const sortButtons = [...root.querySelectorAll('[data-sort]')] as HTMLButtonElement[];
    const paintSortButtons = () => {
      sortButtons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.sort === sort)));
    };

    function render() {
      if (!current) return;
      const topic = topics[current];
      if (!topic) return;
      titleEl!.textContent = `${topic.label} 게시판`;

      const list = [...topic.posts];
      // Falls back to the date order when a count is missing, so a post that
      // has never been opened still sits somewhere sensible.
      if (sort === 'views' && views) {
        list.sort((a, b) => (views![b.id] ?? 0) - (views![a.id] ?? 0));
      }

      listEl!.innerHTML = list
        .map((p) => {
          const n = views?.[p.id];
          const badge =
            sort === 'views' && typeof n === 'number'
              ? `<span class="peek-views">${n.toLocaleString('ko-KR')}회</span>`
              : `<span class="peek-date">${p.date}</span>`;
          return `<li><a href="/posts/${p.id}"><span>${p.title}</span>${badge}</a></li>`;
        })
        .join('');
    }

    function open(id: string) {
      current = id;
      panel!.hidden = false;
      render();
    }
    function close() {
      panel!.hidden = true;
      current = null;
    }

    // Counts are only needed for the 조회순 view, so they are fetched once, on
    // the first interaction, rather than on every page load.
    async function ensureViews() {
      if (views) return;
      try {
        views = await (await fetch('/api/views')).json();
      } catch {
        views = {};
      }
    }

    root.querySelectorAll('[data-topic]').forEach((chip) => {
      const id = (chip as HTMLElement).dataset.topic!;
      chip.addEventListener('mouseenter', () => { open(id); ensureViews().then(render); });
      chip.addEventListener('focus', () => { open(id); ensureViews().then(render); });
      // A touch has no hover: the first tap opens the preview, and the link
      // only follows on a second tap.
      chip.addEventListener('click', (e) => {
        if (matchMedia('(hover: hover)').matches) return;
        if (current !== id) {
          e.preventDefault();
          open(id);
          ensureViews().then(render);
        }
      });
    });

    root.addEventListener('mouseleave', () => {
      if (matchMedia('(hover: hover)').matches) close();
    });

    sortButtons.forEach((b) => {
      b.addEventListener('click', async () => {
        sort = b.dataset.sort as 'date' | 'views';
        try { localStorage.setItem('justies-topic-sort', sort); } catch {}
        paintSortButtons();
        await ensureViews();
        render();
      });
    });

    paintSortButtons();
  }
</script>

<script>
  // Enlarged preview on hover. Pointer devices only — a touch has no hover,
  // and on a phone the card is already the size of the screen.
  const peek = document.getElementById('hover-peek') as HTMLElement | null;
  if (peek && matchMedia('(hover: hover)').matches) {
    const img = peek.querySelector('img') as HTMLImageElement;
    const coverBox = peek.querySelector('.hover-peek-cover') as HTMLElement;
    const catEl = peek.querySelector('[data-hp-cat]')!;
    const dateEl = peek.querySelector('[data-hp-date]')!;
    const titleEl = peek.querySelector('[data-hp-title]')!;
    const takeEl = peek.querySelector('[data-hp-takeaway]')!;

    let raf = 0;
    const place = (e: MouseEvent) => {
      if (raf) return;
      raf = requestAnimationFrame(() => {
        raf = 0;
        const pad = 16;
        const w = peek.offsetWidth;
        const h = peek.offsetHeight;
        // Flip to whichever side has room, so it never runs off screen.
        let x = e.clientX + pad;
        if (x + w > innerWidth - pad) x = e.clientX - w - pad;
        let y = e.clientY + pad;
        if (y + h > innerHeight - pad) y = innerHeight - h - pad;
        if (y < pad) y = pad;
        peek.style.transform = `translate(${Math.max(pad, x)}px, ${y}px)`;
      });
    };

    document.querySelectorAll('[data-peek-card]').forEach((el) => {
      const card = el as HTMLElement;
      card.addEventListener('mouseenter', (e) => {
        const cover = card.dataset.cover;
        if (cover) {
          img.src = cover;
          coverBox.hidden = false;
        } else {
          coverBox.hidden = true;
        }
        catEl.textContent = card.dataset.cat ?? '';
        dateEl.textContent = card.dataset.date ?? '';
        titleEl.textContent = card.dataset.title ?? '';
        takeEl.textContent = card.dataset.takeaway ?? '';
        peek.hidden = false;
        place(e as MouseEvent);
        requestAnimationFrame(() => peek.classList.add('is-open'));
      });
      card.addEventListener('mousemove', place as EventListener);
      card.addEventListener('mouseleave', () => {
        peek.classList.remove('is-open');
        peek.hidden = true;
      });
    });
  }
</script>

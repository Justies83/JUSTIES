---
import '../styles/global.css';
import { site } from '../data/site';
import { CATEGORIES } from '../data/taxonomy';

interface Props {
  title?: string;
  description?: string;
  /** Absolute or root-relative path to a social image. */
  image?: string;
  type?: 'website' | 'article';
  /** JSON-LD for this page. Search engines read this, not the prose. */
  schema?: Record<string, unknown>;
  publishedTime?: Date;
  modifiedTime?: Date;
  /** Set on pages that must never be indexed. */
  noindex?: boolean;
  /** A post's id, so the view counter knows which post to bump. */
  postSlug?: string;
}

const {
  title,
  description = site.description,
  image,
  type = 'website',
  schema,
  publishedTime,
  modifiedTime,
  noindex = false,
  postSlug,
} = Astro.props;
const pageTitle = title ? `${title} — ${site.title}` : `${site.title} — 개인 아카이브`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
// Posts with a cover use it; everything else falls back to the brand card.
const ogImage = new URL(image ?? '/og.png', Astro.site ?? Astro.url).href;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={site.keywords.join(', ')} />
    <meta name="author" content={site.author} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {site.verification.google && (
      <meta name="google-site-verification" content={site.verification.google} />
    )}
    {site.verification.naver && (
      <meta name="naver-site-verification" content={site.verification.naver} />
    )}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f4f1ea" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171a18" media="(prefers-color-scheme: dark)" />

    <meta property="og:site_name" content={site.title} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? site.title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ko_KR" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={`${site.title} — ${site.tagline}`} />
    <meta name="twitter:card" content="summary_large_image" />

    {schema && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    )}

    {/* Ships only once a real publisher id is set, and never on the private
        area — an ad script has no business behind the password gate. */}
    {site.adsensePublisherId && !noindex && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${site.adsensePublisherId}`}
        crossorigin="anonymous"
      />
    )}

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Applied before first paint so the theme never flashes. -->
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem('justies-theme');
          const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
          if (dark) document.documentElement.dataset.theme = 'dark';
        } catch {}
      })();
    </script>
  </head>

  <body data-post-slug={postSlug}>
    <a class="skip-link" href="#main">본문으로 건너뛰기</a>
    {type === 'article' && <div class="read-progress" id="read-progress" aria-hidden="true"></div>}

    <header class="site-header">
      <div class="bar-inner">
      <a class="brand" href="/" aria-label={`${site.title} 홈으로`}>
        <span class="brand-mark" aria-hidden="true">제</span>
        <span class="brand-type">
          <em>{site.title}</em>
          <span>{site.seal}</span>
        </span>
      </a>

      <nav class="desktop-nav" aria-label="주요 메뉴">
        {site.nav.map((item) => (
          <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
        ))}
      </nav>

      <div class="header-tools">
        <button class="icon-button" data-search-open aria-label="기록 검색 열기">
          <span aria-hidden="true">⌕</span><span>검색</span><kbd>⌘K</kbd>
        </button>
        <button class="icon-button" data-theme-toggle aria-label="밝은 화면과 어두운 화면 전환">
          <span data-theme-icon aria-hidden="true">◐</span>
        </button>
      </div>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="bar-inner">
      <div>
        <span class="mono">{site.shortTitle} ARCHIVE</span>
        <p style="margin:0">{CATEGORIES.map((c) => c.en).join(' · ')}</p>
      </div>
      <div>
        <a class="plain-link" href="/rss.xml">RSS</a>
        <span aria-hidden="true"> · </span>
        <a class="plain-link" href="/about">소개</a>
        <span aria-hidden="true"> · </span>
        <a class="plain-link" href="/privacy">개인정보</a>
        <span aria-hidden="true"> · </span>
        <a class="plain-link" href="/admin" rel="nofollow">편집</a>
        <span aria-hidden="true"> · </span>
        <a class="plain-link" href="/private" rel="nofollow">숨김</a>
      </div>
      <span class="mono">누적 방문 <span id="site-visits">···</span> · EST. {site.established}</span>
      </div>
    </footer>

    <nav class="mobile-dock" aria-label="빠른 탐색">
      <a href="/archive"><i aria-hidden="true">▤</i><span>기록</span></a>
      <button data-search-open><i aria-hidden="true">⌕</i><span>검색</span></button>
      <a href="/topics"><i aria-hidden="true">✦</i><span>주제</span></a>
      <a href="/about"><i aria-hidden="true">▣</i><span>소개</span></a>
    </nav>

    <button class="to-top" id="to-top" aria-label="맨 위로" hidden>↑</button>

    <div class="search-layer" id="search-layer" role="dialog" aria-modal="true" aria-label="기록 검색">
      <div class="search-panel">
        <div class="search-field">
          <span aria-hidden="true">⌕</span>
          <input id="search-input" type="search" placeholder="무엇을 찾고 있나요?" autocomplete="off" />
          <button class="icon-button" data-search-close>ESC</button>
        </div>
        <p class="mono" style="margin:0" id="search-status">기록을 불러오는 중…</p>
        <div class="search-results" id="search-results"></div>
      </div>
    </div>

    <script>
      // Theme toggle -------------------------------------------------------
      const root = document.documentElement;
      const icon = document.querySelector('[data-theme-icon]');
      const paintIcon = () => {
        if (icon) icon.textContent = root.dataset.theme === 'dark' ? '☀' : '◐';
      };
      paintIcon();
      document.querySelector('[data-theme-toggle]')?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        if (next === 'dark') root.dataset.theme = 'dark';
        else delete root.dataset.theme;
        try { localStorage.setItem('justies-theme', next); } catch {}
        paintIcon();
      });

      // Search -------------------------------------------------------------
      type Entry = {
        title: string; takeaway: string; url: string;
        category: string; kind: string; tags: string[]; date: string; text: string;
      };
      const layer = document.getElementById('search-layer') as HTMLElement | null;
      const input = document.getElementById('search-input') as HTMLInputElement | null;
      const results = document.getElementById('search-results');
      const status = document.getElementById('search-status');
      let index: Entry[] | null = null;
      let loading = false;

      async function ensureIndex() {
        if (index || loading) return;
        loading = true;
        try {
          const res = await fetch('/search-index.json');
          index = (await res.json()) as Entry[];
          if (status) status.textContent = `${index.length}개의 기록`;
        } catch {
          if (status) status.textContent = '검색 색인을 불러오지 못했습니다.';
        } finally {
          loading = false;
        }
      }

      function render(query: string) {
        if (!results || !index) return;
        const q = query.trim().toLowerCase();
        const hits = q
          ? index.filter((e) => e.text.includes(q)).slice(0, 12)
          : index.slice(0, 8);
        if (status) {
          status.textContent = q
            ? `${hits.length}개의 결과`
            : `${index.length}개의 기록 · 최근 순`;
        }
        results.innerHTML = hits.length
          ? hits
              .map(
                (e) => `<a href="${e.url}"><strong>${e.title}</strong><span>${e.category} · ${e.kind} · ${e.date}</span></a>`
              )
              .join('')
          : '<p class="mono" style="padding:.6rem .5rem">일치하는 기록이 없습니다.</p>';
      }

      function openSearch() {
        if (!layer) return;
        layer.setAttribute('open', '');
        ensureIndex().then(() => render(input?.value ?? ''));
        input?.focus();
      }
      function closeSearch() {
        layer?.removeAttribute('open');
      }

      document.querySelectorAll('[data-search-open]').forEach((b) => b.addEventListener('click', openSearch));
      document.querySelectorAll('[data-search-close]').forEach((b) => b.addEventListener('click', closeSearch));
      layer?.addEventListener('click', (e) => { if (e.target === layer) closeSearch(); });
      input?.addEventListener('input', () => render(input.value));
      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openSearch(); }
        if (e.key === 'Escape') closeSearch();
      });

      // Scroll reveal ------------------------------------------------------
      const targets = document.querySelectorAll('.reveal');
      if (targets.length && 'IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          }),
          { rootMargin: '0px 0px -8% 0px' }
        );
        targets.forEach((t) => io.observe(t));
      } else {
        targets.forEach((t) => t.classList.add('is-visible'));
      }

      // Reading progress + back to top ---------------------------------------
      const progress = document.getElementById('read-progress');
      const toTop = document.getElementById('to-top');
      if (progress || toTop) {
        let ticking = false;
        const paint = () => {
          const max = document.documentElement.scrollHeight - window.innerHeight;
          const y = window.scrollY;
          if (progress) progress.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
          if (toTop) toTop.hidden = y < 600;
          ticking = false;
        };
        addEventListener('scroll', () => {
          if (!ticking) { ticking = true; requestAnimationFrame(paint); }
        }, { passive: true });
        paint();
      }
      toTop?.addEventListener('click', () => {
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
      });

      // Share ----------------------------------------------------------------
      const shareBox = document.querySelector('[data-share]');
      if (shareBox) {
        const url = location.href.split('#')[0];
        const shareTitle = document.title;

        const xLink = shareBox.querySelector('[data-share-x]') as HTMLAnchorElement | null;
        if (xLink) {
          xLink.href =
            `https://twitter.com/intent/tweet?text=${encodeURIComponent(shareTitle)}&url=${encodeURIComponent(url)}`;
        }

        // Only offered where the browser actually has it — on a phone this
        // opens the OS sheet, KakaoTalk included, with no SDK to load.
        const nativeBtn = shareBox.querySelector('[data-share-native]') as HTMLButtonElement | null;
        if (nativeBtn && typeof navigator.share === 'function') {
          nativeBtn.hidden = false;
          nativeBtn.addEventListener('click', () => {
            navigator.share({ title: shareTitle, url }).catch(() => {});
          });
        }

        const copyBtn = shareBox.querySelector('[data-share-copy]') as HTMLButtonElement | null;
        copyBtn?.addEventListener('click', async () => {
          const say = (msg: string) => {
            const original = '주소 복사';
            copyBtn.textContent = msg;
            setTimeout(() => { copyBtn.innerHTML = `<span aria-hidden="true">⧉</span> ${original}`; }, 1600);
          };
          try {
            await navigator.clipboard.writeText(url);
            say('복사했습니다');
          } catch {
            say('복사하지 못했습니다');
          }
        });
      }

      // View counters --------------------------------------------------------
      // A session only ever bumps the same page once; a reload re-fetches the
      // current totals with GET instead of counting itself again.
      (async () => {
        try {
          const slug = document.body.dataset.postSlug || null;
          const seenKey = `justies-hit:${location.pathname}`;
          const alreadyCounted = sessionStorage.getItem(seenKey);
          const qs = slug ? `?slug=${encodeURIComponent(slug)}` : '';
          const res = await fetch(`/api/hit${qs}`, {
            method: alreadyCounted ? 'GET' : 'POST',
            headers: alreadyCounted ? undefined : { 'content-type': 'application/json' },
            body: alreadyCounted ? undefined : JSON.stringify({ slug }),
          });
          if (!res.ok) return;
          const data = await res.json();
          if (!alreadyCounted) sessionStorage.setItem(seenKey, '1');

          const siteEl = document.getElementById('site-visits');
          if (siteEl && typeof data.site === 'number') siteEl.textContent = data.site.toLocaleString('ko-KR');

          const postEl = document.getElementById('post-views');
          if (postEl && typeof data.post === 'number') postEl.textContent = `조회수 ${data.post.toLocaleString('ko-KR')}`;
        } catch {}
      })();

      // Every listed post carries a slot for its own count. One request fills
      // them all; if it never lands the rows simply keep their placeholder.
      (async () => {
        const slots = [...document.querySelectorAll('[data-views-for]')] as HTMLElement[];
        if (!slots.length) return;
        try {
          const views = await (await fetch('/api/views')).json();
          slots.forEach((el) => {
            const n = views[el.dataset.viewsFor!] ?? 0;
            el.textContent = `조회수 ${Number(n).toLocaleString('ko-KR')}`;
          });
        } catch {}
      })();
    </script>
  </body>
</html>

---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import PostRow from '../components/PostRow.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';
import { CATEGORIES } from '../data/taxonomy';
import { getPublishedPosts } from '../lib/posts';

const posts = await getPublishedPosts();

// The home page is the newest writing and little else. `featured` only pulls a
// post forward in the queue — it never holds a slot on its own, so an old
// pinned post cannot keep sitting on the front page as newer ones arrive.
const ordered = [...posts].sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return b.data.date.valueOf() - a.data.date.valueOf();
});

// One lead, two beside it, then the rest as a list. Nothing repeats: every
// slice below picks up where the last one stopped.
const [lead, ...rest] = ordered;
const beside = rest.slice(0, 2);
const listed = rest.slice(2, 11);

const countByCategory = (id: string) => posts.filter((p) => p.data.category === id).length;
// A section with nothing in it is a dead link, so it is left out.
const usedCategories = CATEGORIES.filter((c) => countByCategory(c.id) > 0);

const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${origin}#site`,
      url: origin,
      name: site.title,
      description: site.description,
      inLanguage: 'ko-KR',
      publisher: { '@type': 'Person', name: site.author, url: `${origin}/about` },
    },
    {
      '@type': 'Blog',
      '@id': `${origin}#blog`,
      url: origin,
      name: site.title,
      description: site.description,
      inLanguage: 'ko-KR',
      blogPost: posts.slice(0, 10).map((p) => ({
        '@type': 'BlogPosting',
        headline: p.data.title,
        url: `${origin}/posts/${p.id}`,
        datePublished: p.data.date.toISOString(),
      })),
    },
  ],
};
---

<Base schema={schema}>
  <section class="shell hero">
    <p class="eyebrow hero-eyebrow">{site.seal}</p>
    <h1>질문을 모으고,<br /><i>생각을</i> 남깁니다.</h1>
    <p class="hero-summary">{site.description}</p>
  </section>

  <div class="shell">
    <section class="section" id="latest">
      <SectionHead
        eyebrow="LATEST"
        title="최근에 쓴 글."
        linkHref="/archive"
        linkLabel="전체 기록 보기"
      />

      {lead ? (
        <>
          <div class="bento">
            <PostCard post={lead} lead />
            {beside.map((post) => <PostCard post={post} />)}
          </div>

          {listed.length > 0 && (
            <div class="rows" style="margin-top:1.4rem">
              {listed.map((post, i) => <PostRow post={post} index={i + beside.length + 1} />)}
            </div>
          )}
        </>
      ) : (
        <div class="empty">
          <strong>첫 기록을 기다리고 있습니다.</strong>
          <p style="margin:0">
            <code>src/content/posts/</code> 에 마크다운 파일을 추가하면 이 자리에 바로 나타납니다.
          </p>
        </div>
      )}
    </section>

    <section class="section section-quiet" id="topics">
      <SectionHead eyebrow="TOPICS" title="주제별로 읽기." linkHref="/topics" linkLabel="주제 전체" />
      <nav class="filters" aria-label="주제 이동">
        {usedCategories.map((category) => (
          <a class="chip" href={`/topics/${category.id}`}>
            {category.label} {countByCategory(category.id)}
          </a>
        ))}
      </nav>
    </section>
  </div>
</Base>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm ci)",
      "Bash(npm ci *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(npm uninstall *)",
      "Bash(npm audit*)",
      "Bash(npm ls*)",
      "Bash(npm pkg *)",
      "Bash(node scripts/*)",
      "Bash(node -e *)",
      "Bash(node -p *)",
      "Bash(npx astro *)",
      "Bash(npx wrangler *)",
      "Bash(npx --yes wrangler *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git checkout*)",
      "Bash(git branch*)",
      "Bash(git remote*)",
      "Bash(git rev-parse*)",
      "Bash(git ls-remote*)",
      "Bash(git ls-files*)",
      "Bash(curl *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(mkdir *)",
      "Bash(python3 *)",
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",

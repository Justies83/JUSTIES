# Cloudflare Pages reads this file from the build output root.
# Ignored by the NAS/nginx runtime, which sets the same headers in docker/nginx.conf.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()

# Astro fingerprints these filenames, so they can never go stale.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=604800

# The editing screen. Keep it out of search results and out of frames.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Rebuilt on every deploy; must not be held by a CDN edge.
/search-index.json
  Cache-Control: public, max-age=0, must-revalidate
/rss.xml
  Cache-Control: public, max-age=300

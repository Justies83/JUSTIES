---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostArticle from '../../components/PostArticle.astro';
import { categoryOf } from '../../data/taxonomy';
import { site } from '../../data/site';
import { getPublishedPosts, relatedPosts, socialImage, type Post } from '../../lib/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, posts) },
  }));
};

const { post, related } = Astro.props as { post: Post; related: Post[] };
const category = categoryOf(post.data.category);
const origin = (Astro.site ?? new URL(Astro.url.origin)).origin;
const url = `${origin}/posts/${post.id}`;
const shareImage = socialImage(post);

// Two graphs: the article itself, and where it sits, so a result can show a
// breadcrumb instead of a bare URL.
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      '@id': `${url}#post`,
      mainEntityOfPage: url,
      headline: post.data.title,
      description: post.data.takeaway,
      inLanguage: 'ko-KR',
      datePublished: post.data.date.toISOString(),
      dateModified: (post.data.updated ?? post.data.date).toISOString(),
      author: { '@type': 'Person', name: site.author, url: `${origin}/about` },
      publisher: { '@type': 'Person', name: site.author, url: origin },
      articleSection: category?.label,
      keywords: post.data.tags.join(', ') || undefined,
      image: `${origin}${shareImage}`,
      isAccessibleForFree: true,
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: site.shortTitle, item: origin },
        { '@type': 'ListItem', position: 2, name: '기록', item: `${origin}/archive` },
        {
          '@type': 'ListItem',
          position: 3,
          name: category?.label,
          item: `${origin}/topics/${post.data.category}`,
        },
        { '@type': 'ListItem', position: 4, name: post.data.title, item: url },
      ],
    },
  ],
};
---

<Base
  title={post.data.title}
  description={post.data.takeaway}
  image={shareImage}
  type="article"
  schema={schema}
  publishedTime={post.data.date}
  modifiedTime={post.data.updated ?? post.data.date}
  postSlug={post.id}
>
  <PostArticle post={post} related={related} />
</Base>

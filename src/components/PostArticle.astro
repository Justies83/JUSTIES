---
// The article body of a post page. Shared by the public route and the private
// one behind the password gate, so the two can never drift apart.
import { render } from 'astro:content';
import PostCard from './PostCard.astro';
import { categoryOf, kindOf } from '../data/taxonomy';
import { coverFor, formatDate, type Post } from '../lib/posts';

interface Props {
  post: Post;
  related: Post[];
  /** Private posts link back into /private rather than the public archive. */
  base?: '' | '/private';
  /** Neighbours in the archive, newest-first, for the footer navigation. */
  prev?: Post;
  next?: Post;
}

const { post, related, base = '', prev, next } = Astro.props;
const { Content, headings } = await render(post);

// A table of contents only earns its space on a post with several sections.
// h2 alone: these posts nest one level deep at most, and a flat list reads
// faster than an indented one.
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;
const category = categoryOf(post.data.category);
const kind = kindOf(post.data.kind);
const isPrivate = base === '/private';
const backHref = isPrivate ? '/private' : '/archive';
const backLabel = isPrivate ? '← 숨긴 기록으로' : '← 전체 기록으로';
const cover = coverFor(post);
---

<article class="shell">
  <header class="post-head">
    <p class="mono">
      {isPrivate ? (
        <a href="/private">숨긴 기록</a>
      ) : (
        <>
          <a href="/archive">기록</a> / <a href={`/topics/${post.data.category}`}>{category?.label}</a>
        </>
      )}
    </p>
    <div class="card-meta" style="margin-top:.8rem">
      <span class="pill">{category?.label}</span>
      {isPrivate ? (
        <span class="pill pill--kind">{kind?.label}</span>
      ) : (
        <a class="pill pill--kind" href={`/kinds/${post.data.kind}`}>{kind?.label}</a>
      )}
      {isPrivate && <span class="pill pill--private">숨김</span>}
      {post.data.draft && <span class="pill pill--draft">DRAFT</span>}
    </div>
    <h1>{post.data.title}</h1>
    <p class="post-lead">{post.data.takeaway}</p>
    <div class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.updated && (
        <>
          <span aria-hidden="true">·</span>
          <span>갱신 {formatDate(post.data.updated)}</span>
        </>
      )}
      {!isPrivate && (
        <>
          <span aria-hidden="true">·</span>
          <span id="post-views">···</span>
        </>
      )}
    </div>
    {cover && (
      <figure class="post-cover" style="margin:1.8rem 0 0">
        <img src={cover} alt={post.data.coverAlt} />
      </figure>
    )}
  </header>

  {post.data.source && (
    <p class="source-box">
      <span class="mono">SOURCE</span>
      <a href={post.data.source.url} target="_blank" rel="noopener noreferrer">
        {post.data.source.name} ↗
      </a>
    </p>
  )}

  {showToc && (
    <nav class="toc" aria-label="목차">
      <p class="mono">목차</p>
      <ol>
        {toc.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </nav>
  )}

  <div class="prose">
    <Content />
  </div>

  {post.data.gallery.length > 0 && (
    <section class="gallery" aria-label="사진">
      {post.data.gallery.map((item) => (
        <figure>
          <img src={item.image} alt={item.caption} loading="lazy" decoding="async" />
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))}
    </section>
  )}

  <footer class="post-foot">
    {/* A private post has no public URL worth handing to anyone. */}
    {!isPrivate && (
      <div class="share" data-share>
        <p class="mono">공유</p>
        <div class="share-row">
          {/* Web Share opens the phone's own sheet — KakaoTalk included —
              so this needs no SDK and no developer key. Hidden where the
              browser has no support, which is most desktops. */}
          <button class="share-btn" data-share-native hidden>
            <span aria-hidden="true">↗</span> 공유하기
          </button>
          <button class="share-btn" data-share-copy>
            <span aria-hidden="true">⧉</span> 주소 복사
          </button>
          <a class="share-btn" data-share-x target="_blank" rel="noopener noreferrer">
            <span aria-hidden="true">𝕏</span> X에 올리기
          </a>
        </div>
      </div>
    )}

    {/* Tag pages only list public posts, so a private post links nowhere. */}
    {post.data.tags.length > 0 && (
      <div>
        <p class="mono">TAGS</p>
        <div class="tag-flow">
          {post.data.tags.map((tag) =>
            isPrivate ? (
              <span class="tag">#{tag}</span>
            ) : (
              <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
            )
          )}
        </div>
      </div>
    )}

    {related.length > 0 && (
      <div>
        <p class="mono">RELATED</p>
        <div class="related">
          {related.map((item) => <PostCard post={item} base={base} />)}
        </div>
      </div>
    )}

    {/* Newest-first order, so `prev` is the newer post and sits on the left. */}
    {(prev || next) && (
      <nav class="post-nav" aria-label="이웃 기록">
        {prev ? (
          <a href={`${base}/posts/${prev.id}`}>
            <span class="mono">← 다음 기록</span>
            <strong>{prev.data.title}</strong>
          </a>
        ) : <span />}
        {next ? (
          <a href={`${base}/posts/${next.id}`} class="post-nav-right">
            <span class="mono">이전 기록 →</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : <span />}
      </nav>
    )}

    <div class="post-back">
      <a class="ink-button" href="/">← 메인으로</a>
      <a class="plain-link" href={backHref}>{backLabel}</a>
    </div>
  </footer>
</article>

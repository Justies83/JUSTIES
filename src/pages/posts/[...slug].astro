---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostArticle from '../../components/PostArticle.astro';
import { getPublishedPosts, relatedPosts, type Post } from '../../lib/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, related: relatedPosts(post, posts) },
  }));
};

const { post, related } = Astro.props as { post: Post; related: Post[] };
---

<Base
  title={post.data.title}
  description={post.data.takeaway}
  image={post.data.cover}
  type="article"
>
  <PostArticle post={post} related={related} />
</Base>

---
interface Props {
  /** The 01 · 02 · 03 running number. Omitted where a page has one section. */
  number?: string;
  eyebrow: string;
  /** Left off where the eyebrow alone says enough. */
  title?: string;
  note?: string;
  linkHref?: string;
  linkLabel?: string;
}
const { number, eyebrow, title, note, linkHref, linkLabel } = Astro.props;
---

<header class="section-head">
  <div>
    <p class="mono">{number && `${number} `}<span>{eyebrow}</span></p>
    {title && <h2>{title}</h2>}
  </div>
  {note && <p class="section-note">{note}</p>}
  {linkHref && <a class="plain-link" href={linkHref}>{linkLabel} →</a>}
</header>

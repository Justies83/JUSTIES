---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { CATEGORIES } from '../../data/taxonomy';
import { getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();
---

<Base title="주제" description="주제별로 모아 둔 기록 목록입니다.">
  <div class="shell">
    <section class="section">
      <SectionHead number="—" eyebrow="EXPLORE TOPICS" title="주제별로 읽기." />
      <div class="topics-grid">
        {CATEGORIES.map((category) => (
          <a class="topic reveal" href={`/topics/${category.id}`}>
            <span class="topic-glyph" aria-hidden="true">{category.glyph}</span>
            <small>
              {category.en} · {String(posts.filter((p) => p.data.category === category.id).length).padStart(2, '0')}
            </small>
            <strong>{category.label}</strong>
            <span>{category.blurb}</span>
          </a>
        ))}
      </div>
    </section>
  </div>
</Base>

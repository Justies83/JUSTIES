---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';
import { CATEGORIES, KINDS } from '../data/taxonomy';
---

<Base title="소개" description={site.description}>
  <div class="shell">
    <section class="section">
      <!-- Plain text: SectionHead escapes its title, so a tag here prints as
           characters. It did, on the live site, for a while. -->
      <SectionHead eyebrow="ABOUT THIS PLACE" title="연구실의 메모와 일상의 발견 사이." />
      <div class="prose">
        <p>{site.description}</p>
        <p>
          연구, 기술, 기업, 문화적 경험을 서로 다른 주제가 아니라 같은 관찰 태도로 다룹니다.
          이곳의 기록은 완성된 결론이 아니라, 다시 확인할 수 있는 형태로 남겨 둔 질문에 가깝습니다.
        </p>

        <h2>기록을 나누는 두 축</h2>
        <p><strong>주제</strong>는 무엇에 대한 글인지, <strong>형식</strong>은 어떤 성격의 글인지를 나타냅니다.</p>
        <ul>
          {CATEGORIES.map((c) => <li><strong>{c.label}</strong> — {c.blurb}</li>)}
        </ul>
        <ul>
          {KINDS.map((k) => <li><strong>{k.label}</strong> — {k.blurb}</li>)}
        </ul>

        <h2>편집 원칙</h2>
        <ol>{site.principles.map((p) => <li>{p}</li>)}</ol>

        <h2>알려 둘 것</h2>
        <ul>{site.disclaimers.map((d) => <li>{d}</li>)}</ul>

        <hr />
        <p class="mono">{site.seal} · EST. {site.established}</p>
      </div>
    </section>

    <section class="section section-quiet" id="now">
      <SectionHead
        eyebrow="RIGHT NOW"
        title="지금, 무엇을 보고 있나."
        note={`완결된 글이 되기 전의 생각들. 매달 짧게 갱신합니다. (${site.now.updated} 기준)`}
      />
      <div class="now-list">
        {site.now.items.map((item, i) => (
          <div>
            <span>{String(i + 1).padStart(2, '0')}</span>
            <b>{item.verb}</b>
            <i>{item.text}</i>
          </div>
        ))}
      </div>
    </section>
  </div>
</Base>

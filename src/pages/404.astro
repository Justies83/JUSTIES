---
import Base from '../layouts/Base.astro';
---

<Base title="찾을 수 없는 기록">
  <div class="shell">
    <section class="section" style="min-height:50vh">
      <p class="mono">404 <span>NOT FOUND</span></p>
      <h1 style="margin:.6rem 0 1rem">없는 페이지입니다.</h1>
      <p style="color:var(--soft);max-width:28rem">
        주소가 바뀌었거나 지워진 글일 수 있습니다.
      </p>
      <div class="hero-actions" style="margin-top:1.5rem">
        <a class="ink-button" href="/archive">전체 기록 보기 <span aria-hidden="true">→</span></a>
        <button class="plain-link" data-search-open style="background:none;border:0;cursor:pointer">검색 열기</button>
      </div>
    </section>
  </div>
</Base>

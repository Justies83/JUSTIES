---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import SectionHead from '../../components/SectionHead.astro';
import { collectTags, getPublishedPosts } from '../../lib/posts';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return collectTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
};

const { tag } = Astro.params;
const { posts } = Astro.props as { posts: Awaited<ReturnType<typeof getPublishedPosts>> };
---

<Base title={`#${tag}`} description={`${tag} 태그가 붙은 기록 ${posts.length}개.`}>
  <div class="shell">
    <section class="section">
      <SectionHead
        number="#"
        eyebrow="TAG"
        title={`#${tag}`}
        note={`${posts.length}개의 기록`}
        linkHref="/archive"
        linkLabel="전체 기록 보기"
      />
      <div class="rows">{posts.map((post, i) => <PostRow post={post} index={i} />)}</div>
    </section>
  </div>
</Base>

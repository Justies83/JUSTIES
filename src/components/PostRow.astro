---
import { categoryOf, kindOf } from '../data/taxonomy';
import { coverFor, formatDate, postUrl, readingTime, type Post } from '../lib/posts';

interface Props { post: Post; index: number; base?: '' | '/private'; }
const { post, index, base = '' } = Astro.props;
const category = categoryOf(post.data.category);
const kind = kindOf(post.data.kind);
const cover = coverFor(post);
const label = `${(category?.en ?? 'NOTE').slice(0, 4).toUpperCase()} ${String(index + 1).padStart(2, '0')}`;
---

<article class="row-item reveal" data-category={post.data.category} data-kind={post.data.kind}>
  <a class="row-link" href={base + postUrl(post)}>
    <span class="row-index">{label}</span>
    <span class="row-body">
      <span class="card-meta">
        <span class="pill">{category?.label}</span>
        <span class="pill pill--kind">{kind?.label}</span>
      </span>
      <h3>{post.data.title}</h3>
      <p>{post.data.takeaway}</p>
      <span class="row-foot">
        <span>{formatDate(post.data.date)}</span>
        <span aria-hidden="true">·</span>
        <span>{readingTime(post.body)}분 읽기</span>
        {post.data.tags.length > 0 && <span>{post.data.tags.map((t) => `#${t}`).join(' ')}</span>}
      </span>
    </span>
    {cover ? (
      <span class="row-thumb">
        <img src={cover} alt="" loading="lazy" decoding="async" />
      </span>
    ) : (
      <span class="row-seal" aria-hidden="true">{category?.glyph}</span>
    )}
    <b class="row-arrow" aria-hidden="true">↗</b>
  </a>
</article>

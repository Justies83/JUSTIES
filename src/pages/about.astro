---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { site } from '../data/site';
import { CATEGORIES, KINDS } from '../data/taxonomy';
---

<Base title="소개" description={site.description}>
  <div class="shell">
    <section class="section">
      <!-- Plain text: SectionHead escapes its title, so a tag here prints as
           characters. It did, on the live site, for a while. -->
      <SectionHead eyebrow="ABOUT THIS PLACE" title={site.tagline} />
      <div class="prose">
        <p class="mono">주인장 · 제의 — {site.seal}</p>
        <p>{site.description}</p>

        <h2>기록을 나누는 두 축</h2>
        <p><strong>주제</strong>는 무엇에 대한 글인지, <strong>형식</strong>은 어떤 성격의 글인지를 나타냅니다.</p>
        <ul>
          {CATEGORIES.map((c) => <li><strong>{c.label}</strong> — {c.blurb}</li>)}
        </ul>
        <ul>
          {KINDS.map((k) => <li><strong>{k.label}</strong> — {k.blurb}</li>)}
        </ul>

        <h2>편집 원칙</h2>
        <ol>{site.principles.map((p) => <li>{p}</li>)}</ol>

        <h2>알려 둘 것</h2>
        <ul>{site.disclaimers.map((d) => <li>{d}</li>)}</ul>

        <hr />
        <p class="mono">{site.seal} · EST. {site.established}</p>
      </div>
    </section>

  </div>
</Base>

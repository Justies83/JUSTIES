---
// The article body of a post page. Shared by the public route and the private
// one behind the password gate, so the two can never drift apart.
import { render } from 'astro:content';
import PostCard from './PostCard.astro';
import { categoryOf, kindOf } from '../data/taxonomy';
import {
  coverFor,
  formatDate,
  paperFigureLabel,
  paperHref,
  paperLicenseLabel,
  type Post,
} from '../lib/posts';

interface Props {
  post: Post;
  related: Post[];
  /** Private posts link back into /private rather than the public archive. */
  base?: '' | '/private';
  /** Neighbours in the archive, newest-first, for the footer navigation. */
  prev?: Post;
  next?: Post;
}

const { post, related, base = '', prev, next } = Astro.props;
const { Content, headings } = await render(post);

// A table of contents only earns its space on a post with several sections.
// h2 alone: these posts nest one level deep at most, and a flat list reads
// faster than an indented one.
const toc = headings.filter((h) => h.depth === 2);
const showToc = toc.length >= 3;
const category = categoryOf(post.data.category);
const kind = kindOf(post.data.kind);
const isPrivate = base === '/private';
const backHref = isPrivate ? '/private' : '/archive';
const backLabel = isPrivate ? '← 숨긴 기록으로' : '← 전체 기록으로';
const cover = coverFor(post);
const bodyChars = post.body?.replace(/\s+/g, '').length ?? 0;
const readingMinutes = Math.max(1, Math.round(bodyChars / 450));
// Recent posts also put the cover image at the top of the body, with its
// caption. Showing the header cover as well made the same photo appear
// twice. Older posts do not repeat it in the body, so they keep the header
// cover — only skip it when the body already carries the same image.
const bodyHasCover = Boolean(cover && post.body?.includes(cover));
const paper = post.data.paper;
const paperLink = paper ? paperHref(paper) : undefined;
const provenanceNote =
  paper?.figurePolicy === 'original-cc-by'
    ? '원문 라이선스(CC BY 4.0) 규정에 따라 출처·저자·DOI를 명시해 인용했다.'
    : paper?.figurePolicy === 'text-only'
      ? '원문 저작권을 준수해 원문 이미지를 전재하지 않고 핵심 구조와 수치를 텍스트로 재구성했다.'
      : '저작권 준수를 위해 원문 Figure를 캡처하지 않고, 공개된 메커니즘·수치를 바탕으로 모식도와 도표를 직접 재작성(Redrawn)했다.';
---

<article class="shell post-article">
  <header class="post-head">
    <p class="mono">
      {isPrivate ? (
        <a href="/private">숨긴 기록</a>
      ) : (
        <>
          <a href="/archive">기록</a> / <a href={`/topics/${post.data.category}`}>{category?.label}</a>
          {paper && (
            <>
              {' '} / <a href="/papers">논문 소개</a>
            </>
          )}
        </>
      )}
    </p>
    <div class="card-meta" style="margin-top:.8rem">
      <span class="pill">{category?.label}</span>
      {isPrivate ? (
        <span class="pill pill--kind">{kind?.label}</span>
      ) : (
        <a class="pill pill--kind" href={`/kinds/${post.data.kind}`}>{kind?.label}</a>
      )}
      {isPrivate && <span class="pill pill--private">숨김</span>}
      {post.data.draft && <span class="pill pill--draft">DRAFT</span>}
    </div>
    <h1>{post.data.title}</h1>
    <p class="post-lead">{post.data.takeaway}</p>
    <div class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {post.data.updated && (
        <>
          <span aria-hidden="true">·</span>
          <span>갱신 {formatDate(post.data.updated)}</span>
        </>
      )}
      <span aria-hidden="true">·</span>
      <span>약 {readingMinutes}분 읽기</span>
      {!isPrivate && (
        <>
          <span aria-hidden="true">·</span>
          <span id="post-views">···</span>
        </>
      )}
    </div>
    {cover && !bodyHasCover && (
      <figure class="post-cover">
        <img src={cover} alt={post.data.coverAlt} />
      </figure>
    )}
  </header>

  {paper && (
    <section class="paper-box" aria-label="원문 논문 및 저작권 정보">
      <div class="paper-box-head">
        <span class="mono">PRIMARY PAPER · 원문 서지</span>
        <div class="paper-badges">
          {paper.license && <span class="pill">{paperLicenseLabel(paper.license)}</span>}
          {paper.figurePolicy && <span class="pill pill--kind">{paperFigureLabel(paper.figurePolicy)}</span>}
        </div>
      </div>

      <div class="paper-cite">
        {paper.title && <p class="paper-cite-title">{paper.title}</p>}
        <p class="paper-cite-meta">
          {[paper.authors, paper.journal, paper.year].filter(Boolean).join(' · ')}
          {paperLink && (
            <>
              {' · '}
              <a href={paperLink} target="_blank" rel="noopener noreferrer">
                {paper.doi ? `DOI: ${paper.doi}` : '원문 보기'} ↗
              </a>
            </>
          )}
        </p>
      </div>

      {paper.ownerNote && (
        <div class="paper-owner-note">
          <span class="mono">RESEARCHER&apos;S NOTE · 내 해석 한 줄</span>
          <p>{paper.ownerNote}</p>
        </div>
      )}

      <p class="paper-provenance">{provenanceNote}</p>
    </section>
  )}

  {post.data.source && (
    <p class="source-box">
      <span class="mono">SOURCE</span>
      <a href={post.data.source.url} target="_blank" rel="noopener noreferrer">
        {post.data.source.name} ↗
      </a>
    </p>
  )}

  {showToc && (
    <nav class="toc" aria-label="목차">
      <p class="mono">목차</p>
      <ol>
        {toc.map((h) => (
          <li><a href={`#${h.slug}`}>{h.text}</a></li>
        ))}
      </ol>
    </nav>
  )}

  <div class="prose">
    <Content />
  </div>

  {post.data.gallery.length > 0 && (
    <section class="gallery" aria-label="사진">
      {post.data.gallery.map((item) => (
        <figure>
          <img src={item.image} alt={item.caption} loading="lazy" decoding="async" />
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))}
    </section>
  )}

  {!isPrivate && (
    <aside class="author-card" aria-label="글쓴이 소개">
      <div class="author-avatar" aria-hidden="true">J</div>
      <div class="author-body">
        <p class="mono">WRITTEN BY 제의 / JUSTIES</p>
        <p>
          생명과학 연구자의 시선으로 바이오·의학 논문을 읽고, 원문 공시와 통계를 바탕으로
          경제·국제 정세의 인사이트를 정리한다.
        </p>
        <div class="author-links">
          <a class="plain-link" href="/papers">논문 소개</a>
          <a class="plain-link" href="/about">소개 보기</a>
          <a class="plain-link" href="/topics/science">바이오 · 과학</a>
          <a class="plain-link" href="/topics/finance">경제 · 인사이트</a>
        </div>
      </div>
    </aside>
  )}

  <footer class="post-foot">
    {/* A private post has no public URL worth handing to anyone. */}
    {!isPrivate && (
      <div class="share" data-share>
        <p class="mono">공유</p>
        <div class="share-row">
          {/* Web Share opens the phone's own sheet — KakaoTalk included —
              so this needs no SDK and no developer key. Hidden where the
              browser has no support, which is most desktops. */}
          <button class="share-btn" data-share-native hidden>
            <span aria-hidden="true">↗</span> 공유하기
          </button>
          <button class="share-btn" data-share-copy>
            <span aria-hidden="true">⧉</span> 주소 복사
          </button>
          <a class="share-btn" data-share-x target="_blank" rel="noopener noreferrer">
            <span aria-hidden="true">𝕏</span> X에 올리기
          </a>
        </div>
      </div>
    )}

    {/* Tag pages only list public posts, so a private post links nowhere. */}
    {post.data.tags.length > 0 && (
      <div>
        <p class="mono">TAGS</p>
        <div class="tag-flow">
          {post.data.tags.map((tag) =>
            isPrivate ? (
              <span class="tag">#{tag}</span>
            ) : (
              <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
            )
          )}
        </div>
      </div>
    )}

    {related.length > 0 && (
      <div>
        <p class="mono">RELATED</p>
        <div class="related">
          {related.map((item) => <PostCard post={item} base={base} />)}
        </div>
      </div>
    )}

    {/* Newest-first order, so `prev` is the newer post and sits on the left. */}
    {(prev || next) && (
      <nav class="post-nav" aria-label="이웃 기록">
        {prev ? (
          <a href={`${base}/posts/${prev.id}`}>
            <span class="mono">← 다음 기록</span>
            <strong>{prev.data.title}</strong>
          </a>
        ) : <span />}
        {next ? (
          <a href={`${base}/posts/${next.id}`} class="post-nav-right">
            <span class="mono">이전 기록 →</span>
            <strong>{next.data.title}</strong>
          </a>
        ) : <span />}
      </nav>
    )}

    <div class="post-back">
      <a class="ink-button" href="/">← 메인으로</a>
      <a class="plain-link" href={backHref}>{backLabel}</a>
    </div>
  </footer>
</article>

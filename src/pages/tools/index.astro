---
import { existsSync } from 'node:fs';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { TOOLS } from '../../data/tools';

// A tool is only linked once its HTML is actually sitting in public/tools.
// Checked here, at build time, rather than trusted from the registry — an
// entry can be written before the file arrives without shipping a dead link.
const tools = TOOLS.map((tool) => ({
  ...tool,
  href: `/tools/${tool.file}`,
  ready: existsSync(new URL(`../../../public/tools/${tool.file}`, import.meta.url)),
}));
---

<Base
  title="도구"
  description="실험과 분석에 쓰는 작은 도구들. 브라우저에서 바로 돌아갑니다."
>
  <div class="shell">
    <section class="section">
      <SectionHead
        eyebrow="TOOLS"
        title="직접 쓰려고 만든 도구."
        note="연구하다 매번 손으로 하던 계산을 한 번씩 자동화한 것들입니다. 설치 없이 브라우저에서 돌아갑니다."
      />

      {tools.length > 0 ? (
        <div class="tool-list">
          {tools.map((tool) => (
            <article class="tool-card reveal" id={tool.id}>
              <div class="card-meta">
                <span class="pill">{tool.audience}</span>
                {tool.ready ? (
                  <span class="pill pill--kind">사용 가능</span>
                ) : (
                  <span class="pill pill--draft">준비 중</span>
                )}
              </div>

              <h3>{tool.title}</h3>
              <p class="tool-blurb">{tool.blurb}</p>

              {tool.detail.map((line) => <p>{line}</p>)}

              <footer>
                {tool.ready ? (
                  <a class="ink-button" href={tool.href}>도구 열기 →</a>
                ) : (
                  <span class="mono">파일 준비 중입니다.</span>
                )}
                {tool.post && (
                  <a class="plain-link" href={tool.post}>설명 읽기 →</a>
                )}
                <span class="mono tool-updated">갱신 {tool.updated}</span>
              </footer>
            </article>
          ))}
        </div>
      ) : (
        <div class="empty">
          <strong>아직 공개한 도구가 없습니다.</strong>
        </div>
      )}
    </section>
  </div>
</Base>

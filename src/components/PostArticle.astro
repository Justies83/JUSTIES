---
// The article body of a post page. Shared by the public route and the private
// one behind the password gate, so the two can never drift apart.
import { render } from 'astro:content';
import PostCard from './PostCard.astro';
import { categoryOf, kindOf } from '../data/taxonomy';
import { formatDate, readingTime, type Post } from '../lib/posts';

interface Props {
  post: Post;
  related: Post[];
  /** Private posts link back into /private rather than the public archive. */
  base?: '' | '/private';
}

const { post, related, base = '' } = Astro.props;
const { Content } = await render(post);
const category = categoryOf(post.data.category);
const kind = kindOf(post.data.kind);
const isPrivate = base === '/private';
const backHref = isPrivate ? '/private' : '/archive';
const backLabel = isPrivate ? '← 숨긴 기록으로' : '← 전체 기록으로';
---

<article class="shell">
  <header class="post-head">
    <p class="mono">
      {isPrivate ? (
        <a href="/private">숨긴 기록</a>
      ) : (
        <>
          <a href="/archive">기록</a> / <a href={`/topics/${post.data.category}`}>{category?.label}</a>
        </>
      )}
    </p>
    <div class="card-meta" style="margin-top:.8rem">
      <span class="pill">{category?.label}</span>
      {isPrivate ? (
        <span class="pill pill--kind">{kind?.label}</span>
      ) : (
        <a class="pill pill--kind" href={`/kinds/${post.data.kind}`}>{kind?.label}</a>
      )}
      {isPrivate && <span class="pill pill--private">숨김</span>}
      {post.data.draft && <span class="pill pill--draft">DRAFT</span>}
    </div>
    <h1>{post.data.title}</h1>
    <p class="post-lead">{post.data.takeaway}</p>
    <div class="post-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      <span aria-hidden="true">·</span>
      <span>{readingTime(post.body)}분 읽기</span>
      {post.data.updated && (
        <>
          <span aria-hidden="true">·</span>
          <span>갱신 {formatDate(post.data.updated)}</span>
        </>
      )}
    </div>
    {post.data.cover && (
      <figure class="post-cover" style="margin:1.8rem 0 0">
        <img src={post.data.cover} alt={post.data.coverAlt} />
      </figure>
    )}
  </header>

  {post.data.source && (
    <p class="source-box">
      <span class="mono">SOURCE</span>
      <a href={post.data.source.url} target="_blank" rel="noopener noreferrer">
        {post.data.source.name} ↗
      </a>
    </p>
  )}

  <div class="prose">
    <Content />
  </div>

  {post.data.gallery.length > 0 && (
    <section class="gallery" aria-label="사진">
      {post.data.gallery.map((item) => (
        <figure>
          <img src={item.image} alt={item.caption} loading="lazy" decoding="async" />
          {item.caption && <figcaption>{item.caption}</figcaption>}
        </figure>
      ))}
    </section>
  )}

  <footer class="post-foot">
    {/* Tag pages only list public posts, so a private post links nowhere. */}
    {post.data.tags.length > 0 && (
      <div>
        <p class="mono">TAGS</p>
        <div class="tag-flow">
          {post.data.tags.map((tag) =>
            isPrivate ? (
              <span class="tag">#{tag}</span>
            ) : (
              <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
            )
          )}
        </div>
      </div>
    )}

    {related.length > 0 && (
      <div>
        <p class="mono">RELATED</p>
        <div class="related">
          {related.map((item) => <PostCard post={item} base={base} />)}
        </div>
      </div>
    )}

    <a class="plain-link" href={backHref}>{backLabel}</a>
  </footer>
</article>
